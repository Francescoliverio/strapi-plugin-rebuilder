# =============================================================================
# strapi-plugin-rebuilder — GitLab provider
# =============================================================================
# Copy the relevant lines into your Strapi project's .env file.
# Restart Strapi after changing any of these.

# Provider selector. Default is "gitlab" so this line is technically optional.
NEXJS_REBUILDER_PROVIDER=gitlab

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# GitLab project numeric ID (Settings → General → Project ID).
NEXJS_REBUILDER_GITLAB_PROJECT_ID=12345678

# Pipeline trigger token.
# Create it under Settings → CI/CD → Pipeline triggers.
# Docs: https://docs.gitlab.com/ci/triggers/
NEXJS_REBUILDER_GITLAB_TRIGGER_TOKEN=glptt-xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret used to verify incoming webhooks. The plugin checks this
# against the X-Gitlab-Token header. Use a long random string.
# In the GitLab webhook config, paste the same value into "Secret token"
# and enable the "Pipeline events" trigger.
NEXJS_REBUILDER_GITLAB_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Branch or tag to trigger. Default: main
# NEXJS_REBUILDER_GITLAB_REF=main

# Override only for self-managed GitLab. Default: https://gitlab.com/api/v4
# NEXJS_REBUILDER_GITLAB_API_BASE_URL=https://gitlab.your-company.com/api/v4
