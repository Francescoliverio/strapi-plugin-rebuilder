# =============================================================================
# strapi-plugin-rebuilder — GitHub Actions provider
# =============================================================================
# Copy the relevant lines into your Strapi project's .env file.
# Restart Strapi after changing any of these.
#
# Reminder: GitHub webhook signature verification needs raw body access.
# Make sure config/middlewares.ts has:
#   { name: "strapi::body", config: { includeUnparsed: true } }

# Provider selector. Required to switch off the GitLab default.
NEXJS_REBUILDER_PROVIDER=github

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Repository owner (user or org) and repo name.
NEXJS_REBUILDER_GITHUB_OWNER=your-org
NEXJS_REBUILDER_GITHUB_REPO=your-nextjs-repo

# Workflow file name (under .github/workflows) or numeric workflow ID.
# Must accept workflow_dispatch with `build_message` and `triggered_by` inputs.
# See: examples/github-actions-deploy.yml
NEXJS_REBUILDER_GITHUB_WORKFLOW_ID=deploy.yml

# Token with permission to dispatch workflows.
# Use a fine-grained PAT with "Actions: read and write" on the target repo,
# or a GitHub App installation token with equivalent permissions.
# Docs: https://docs.github.com/en/rest/actions/workflows
NEXJS_REBUILDER_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret used to verify incoming webhooks via X-Hub-Signature-256.
# Paste the same value into the GitHub webhook "Secret" field.
# Enable "Workflow runs" and "Workflow jobs" events.
NEXJS_REBUILDER_GITHUB_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Branch or tag to dispatch the workflow on. Default: main
# NEXJS_REBUILDER_GITHUB_REF=main

# Override only for GitHub Enterprise Server. Default: https://api.github.com
# NEXJS_REBUILDER_GITHUB_API_BASE_URL=https://github.your-company.com/api/v3
